#include <winver.h>
#include "resource.h"

#pragma code_page(65001)

IDI_FURIGANAPAD ICON "furiganapad.ico"

1 24 "furiganapad.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FURIGANAPAD_VERSION_RC
 PRODUCTVERSION FURIGANAPAD_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104b0"
        BEGIN
            VALUE "CompanyName", "Hiragana IME for Windows contributors"
            VALUE "FileDescription", "ふりがなパッド"
            VALUE "FileVersion", FURIGANAPAD_VERSION_STR
            VALUE "InternalName", "furiganapad"
            VALUE "LegalCopyright", "Copyright 2019-2025 Esrille Inc.; Windows port 2026. LGPL-2.1-or-later"
            VALUE "OriginalFilename", "furiganapad.exe"
            VALUE "ProductName", "ふりがなパッド for Windows"
            VALUE "ProductVersion", FURIGANAPAD_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x411, 1200
    END
END
