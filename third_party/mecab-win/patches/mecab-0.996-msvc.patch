diff --git a/mecab/src/config.h b/mecab/src/config.h
new file mode 100644
index 0000000..90093cd
--- /dev/null
+++ b/mecab/src/config.h
@@ -0,0 +1,51 @@
+/* config.h - hand-written for MSVC (Win32 / x64) builds of MeCab 0.996.
+ *
+ * Normally generated by autoconf on Unix.  MSVC has no configure step, so
+ * this file provides the subset of HAVE_* macros MeCab's sources actually
+ * test for.  It mirrors the defines used by src/Makefile.msvc.in upstream.
+ */
+#ifndef MECAB_CONFIG_H
+#define MECAB_CONFIG_H
+
+/* ---- package/version (used by mecab.cpp --version and dic version checks) */
+#define PACKAGE         "mecab"
+#define PACKAGE_NAME    "mecab"
+#define PACKAGE_TARNAME "mecab"
+#define PACKAGE_VERSION "0.996"
+#define PACKAGE_STRING  "mecab 0.996"
+#define PACKAGE_BUGREPORT "taku@chasen.org"
+#define PACKAGE_URL     ""
+#define VERSION         "0.996"
+
+/* ---- headers that MSVC provides */
+#define STDC_HEADERS    1
+#define HAVE_CTYPE_H    1
+#define HAVE_STDLIB_H   1
+#define HAVE_STRING_H   1
+#define HAVE_MEMORY_H   1
+#define HAVE_INTTYPES_H 1
+#define HAVE_STDINT_H   1
+#define HAVE_SYS_TYPES_H 1
+#define HAVE_SYS_STAT_H  1
+#define HAVE_FCNTL_H     1
+#define HAVE_IO_H        1
+#define HAVE_WINDOWS_H   1
+
+/* ---- functions */
+#define HAVE_GETENV 1
+#define HAVE_UNSIGNED_LONG_LONG_INT 1
+
+/* Fallback rc file used by load_dictionary_resource() when nothing else is
+ * found.  Defined here (not on the compiler command line) so that the
+ * embedded double quotes survive CMake's command line escaping. */
+#define MECAB_DEFAULT_RC "mecabrc"
+
+/* Deliberately NOT defined (Unix-only / not available on MSVC):
+ *   HAVE_MMAP, HAVE_ICONV, HAVE_PTHREAD_H, HAVE_DIRENT_H, HAVE_UNISTD_H,
+ *   HAVE_SYS_MMAN_H, HAVE_SYS_PARAM_H, HAVE_SYS_TIMES_H, HAVE_DLFCN_H,
+ *   HAVE_GETPAGESIZE, HAVE_OPENDIR, HAVE_STRINGS_H, HAVE_ZLIB_H
+ * MeCab falls back to its own Win32 codepaths (mmap.h CreateFileMapping,
+ * iconv_utils.cpp MultiByteToWideChar, utils.cpp FindFirstFile).
+ */
+
+#endif  /* MECAB_CONFIG_H */
