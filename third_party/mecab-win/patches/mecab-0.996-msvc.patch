diff --git a/mecab/src/libmecab.cpp b/mecab/src/libmecab.cpp
index 296382b..68d7a34 100644
--- a/mecab/src/libmecab.cpp
+++ b/mecab/src/libmecab.cpp
@@ -23,14 +23,40 @@ const size_t kErrorBufferSize = 256;
 #if defined(_WIN32) && !defined(__CYGWIN__)
 namespace {
 DWORD g_tls_index = TLS_OUT_OF_INDEXES;
+
+// When libmecab is linked *statically* into an .exe, DllMain() below is never
+// invoked by the CRT (it only runs for real DLLs), so the TLS slot has to be
+// created on demand.  With a DLL build this simply returns immediately.
+void ensureTlsIndex() {
+  if (g_tls_index != TLS_OUT_OF_INDEXES) {
+    return;
+  }
+  const DWORD idx = ::TlsAlloc();
+  if (idx == TLS_OUT_OF_INDEXES) {
+    return;
+  }
+  if (::InterlockedCompareExchange(
+          reinterpret_cast<volatile LONG *>(&g_tls_index),
+          static_cast<LONG>(idx), static_cast<LONG>(TLS_OUT_OF_INDEXES)) !=
+      static_cast<LONG>(TLS_OUT_OF_INDEXES)) {
+    ::TlsFree(idx);  // somebody else won the race
+    return;
+  }
+  LPVOID data = ::LocalAlloc(LPTR, kErrorBufferSize);
+  if (data) {
+    ::TlsSetValue(idx, data);
+  }
+}
 }
 
 const char *getGlobalError() {
+  ensureTlsIndex();
   LPVOID data = ::TlsGetValue(g_tls_index);
   return data == NULL ? kUnknownError : reinterpret_cast<const char *>(data);
 }
 
 void setGlobalError(const char *str) {
+  ensureTlsIndex();
   char *data = reinterpret_cast<char *>(::TlsGetValue(g_tls_index));
   if (data == NULL) {
     return;
